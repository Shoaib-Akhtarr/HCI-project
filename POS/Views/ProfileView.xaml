<UserControl x:Class="POS.Views.ProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:POS.Views"
             xmlns:vm="clr-namespace:POS.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200"
             Background="#F5F5F5">
    
    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,40">
            <TextBlock Text="{DynamicResource Lang_ProfileSettings}" 
                       FontSize="32" FontWeight="Bold" Foreground="#111111"
                       FontStyle="Italic"/>
            <Border Height="1" Background="#E0E0E0" Margin="0,15,0,0"/>
        </StackPanel>

        <!-- Profile Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Settings Card -->
            <Border Grid.Column="0" Background="White" CornerRadius="4" BorderBrush="#E0E0E0" BorderThickness="1" VerticalAlignment="Top" Padding="30">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Lang_Language}" FontSize="18" FontWeight="Bold" Margin="0,0,0,10" Foreground="#111111"/>
                    <TextBlock Text="{DynamicResource Lang_SelectLanguage}" FontSize="13" Foreground="#555555" Margin="0,0,0,25" TextWrapping="Wrap"/>

                    <!-- Language Toggle Buttons -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <Button Grid.Column="0" Content="ENGLISH" Margin="0,0,5,0" Height="45"
                                Command="{Binding ChangeLanguageCommand}" CommandParameter="English">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="White"/>
                                    <Setter Property="Foreground" Value="#111111"/>
                                    <Setter Property="BorderBrush" Value="#E0E0E0"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentLanguage}" Value="English">
                                            <Setter Property="Background" Value="#111111"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="BorderBrush" Value="#111111"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Grid.Column="1" Content="اردو" Margin="5,0,0,0" Height="45"
                                Command="{Binding ChangeLanguageCommand}" CommandParameter="Urdu" FontFamily="Urdu Typesetting, Jameel Noori Nastaleeq, Arial">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="White"/>
                                    <Setter Property="Foreground" Value="#111111"/>
                                    <Setter Property="BorderBrush" Value="#E0E0E0"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentLanguage}" Value="Urdu">
                                            <Setter Property="Background" Value="#111111"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="BorderBrush" Value="#111111"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>

                    <Border Height="1" Background="#F0F0F0" Margin="0,30"/>
                    
                    <TextBlock Text="{DynamicResource Lang_Theme}" FontSize="18" FontWeight="Bold" Margin="0,0,0,15" Foreground="#111111"/>
                    <Border Background="#F9F9F9" Padding="15" BorderBrush="#E0E0E0" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="20" Height="20" Fill="#111111" Margin="0,0,10,0"/>
                            <TextBlock Text="MONOCHROME (Active)" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- User Info (Placeholder for now) -->
            <StackPanel Grid.Column="1" Margin="60,0,0,0">
                <Border Width="120" Height="120" Background="#111111" CornerRadius="60" HorizontalAlignment="Left" Margin="0,0,0,20">
                    <TextBlock Text="A" Foreground="White" FontSize="48" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Karobar Sahulat Admin" FontSize="24" FontWeight="Bold" Foreground="#111111"/>
                <TextBlock Text="Business Owner" FontSize="14" Foreground="#555555" Margin="0,0,0,30"/>
                
                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                    <TextBlock Text="Software Version:" Width="150" Foreground="#555555"/>
                    <TextBlock Text="v2.4.0 (Enterprise)" FontWeight="Bold"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Last Database Sync:" Width="150" Foreground="#555555"/>
                    <TextBlock Text="Just Now" FontWeight="Bold"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
