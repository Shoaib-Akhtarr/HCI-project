<UserControl x:Class="POS.Views.PurchasesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1000" Background="#F5F6FA">
    
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header & Selection -->
            <RowDefinition Height="Auto"/> <!-- Input Form -->
            <RowDefinition Height="*"/>    <!-- Activity Log -->
        </Grid.RowDefinitions>

        <!-- 1. Selection Tier: Modern Toggle Buttons -->
        <StackPanel Grid.Row="0" Margin="0,0,0,25">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                <TextBlock Text="STOCK PROCUREMENT" FontSize="26" FontWeight="Black" Foreground="#111827"/>
            </StackPanel>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <RadioButton Grid.Column="0" IsChecked="{Binding IsNewProduct}" Style="{x:Null}" HorizontalContentAlignment="Center">
                    <RadioButton.Template>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="border" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="20,15" Cursor="Hand">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="✨" FontSize="18" Margin="0,0,10,0"/>
                                    <TextBlock Text="NEW PRODUCT ARRIVAL" FontSize="12" FontWeight="Black" Foreground="#64748B"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush" Value="#1D9E75"/>
                                    <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                                    <Setter TargetName="border" Property="Background" Value="#F0FDFA"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </RadioButton.Template>
                </RadioButton>

                <RadioButton Grid.Column="2" Style="{x:Null}" IsEnabled="True">
                    <RadioButton.IsChecked>
                        <Binding Path="IsNewProduct" Mode="TwoWay" Converter="{StaticResource InverseBool}" UpdateSourceTrigger="PropertyChanged" />
                    </RadioButton.IsChecked>
                    <RadioButton.Template>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="border" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="20,15" Cursor="Hand">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="📦" FontSize="18" Margin="0,0,10,0"/>
                                    <TextBlock Text="RESTOCK EXISTING INVENTORY" FontSize="12" FontWeight="Black" Foreground="#64748B"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush" Value="#1D9E75"/>
                                    <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                                    <Setter TargetName="border" Property="Background" Value="#F0FDFA"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </RadioButton.Template>
                </RadioButton>
            </Grid>
        </StackPanel>

        <!-- 2. Input Tier: High-Density Horizontal Form -->
        <Border Grid.Row="1" Background="White" CornerRadius="16" BorderBrush="#E2E8F0" BorderThickness="1" Padding="25" Margin="0,0,0,25" Effect="{x:Null}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Row 1 Labels -->
                    <RowDefinition Height="Auto"/> <!-- Row 1 Fields -->
                    <RowDefinition Height="20"/>   <!-- Spacer -->
                    <RowDefinition Height="Auto"/> <!-- Row 2 Labels -->
                    <RowDefinition Height="Auto"/> <!-- Row 2 Fields -->
                    <RowDefinition Height="25"/>   <!-- Action Spacer -->
                    <RowDefinition Height="Auto"/> <!-- Action Button -->
                </Grid.RowDefinitions>

                <!-- Row 1: Common Fields -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="SUPPLIER NAME" FontSize="9" FontWeight="Black" Foreground="#94A3B8"/>
                    <TextBlock Grid.Column="2" Text="SELECT PRODUCT" FontSize="9" FontWeight="Black" Foreground="#94A3B8"/>
                    <TextBlock Grid.Column="4" Text="CATEGORY" FontSize="9" FontWeight="Black" Foreground="#94A3B8"/>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBox Grid.Column="0" Text="{Binding SupplierName, UpdateSourceTrigger=PropertyChanged}" Padding="15,12" Background="#F1F5F9" BorderThickness="0" FontSize="13">
                        <TextBox.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></TextBox.Resources>
                    </TextBox>

                    <!-- Product Entry Content Control -->
                    <Grid Grid.Column="2">
                        <!-- Existing Product Mode -->
                        <ComboBox Visibility="{Binding IsNewProduct, Converter={StaticResource InverseBoolToVis}}" 
                                  ItemsSource="{Binding AvailableProducts}" SelectedItem="{Binding SelectedProduct}" 
                                  DisplayMemberPath="Name" IsEditable="True" Height="44" Padding="15,10" Background="#F1F5F9" BorderThickness="0">
                            <ComboBox.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></ComboBox.Resources>
                        </ComboBox>
                        <!-- New Product Mode -->
                        <TextBox Visibility="{Binding IsNewProduct, Converter={StaticResource BoolToVis}}" 
                                 Text="{Binding NewProductName, UpdateSourceTrigger=PropertyChanged}" Padding="15,12" Background="#F1F5F9" BorderThickness="0">
                            <TextBox.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></TextBox.Resources>
                        </TextBox>
                    </Grid>

                    <TextBox Grid.Column="4" Text="{Binding Category}" Padding="15,12" Background="#F1F5F9" BorderThickness="0" 
                             IsEnabled="{Binding IsNewProduct}">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="Opacity" Value="1.0"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsNewProduct}" Value="False">
                                        <Setter Property="Opacity" Value="0.5"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                        <TextBox.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></TextBox.Resources>
                    </TextBox>
                </Grid>

                <!-- Row 2: Financials & Volume -->
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="UNIT COST (Rs)" FontSize="9" FontWeight="Black" Foreground="#94A3B8"/>
                    <TextBlock Grid.Column="2" Text="QUANTITY" FontSize="9" FontWeight="Black" Foreground="#94A3B8"/>
                    <TextBlock Grid.Column="4" Text="NEW SELLING PRICE (Rs)" FontSize="9" FontWeight="Black" Foreground="#94A3B8"/>                </Grid>

                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBox Grid.Column="0" Text="{Binding CostPrice}" Padding="15,12" Background="#F0FDFA" BorderBrush="#1D9E75" BorderThickness="1">
                        <TextBox.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></TextBox.Resources>
                    </TextBox>

                    <Grid Grid.Column="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Command="{Binding DecrementQuantityCommand}" Content="-" Width="40" Background="#F1F5F9" BorderThickness="0" FontSize="18" FontWeight="Bold"/>
                        <TextBox Grid.Column="1" Text="{Binding Quantity}" Padding="15,10" Background="Transparent" BorderThickness="0" FontSize="18" FontWeight="Black" TextAlignment="Center"/>
                        <Button Grid.Column="2" Command="{Binding IncrementQuantityCommand}" Content="+" Width="40" Background="#F1F5F9" BorderThickness="0" FontSize="18" FontWeight="Bold"/>
                    </Grid>

                    <TextBox Grid.Column="4" Text="{Binding SellingPrice}" Padding="15,12" Background="#F0FDFA" BorderBrush="#1D9E75" BorderThickness="1">
                        <TextBox.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></TextBox.Resources>
                    </TextBox>
                </Grid>

                <!-- 3. Record Button -->
                <Button Grid.Row="6" Command="{Binding RecordPurchaseCommand}" Content="RECORD PURCHASE &amp; UPDATE STOCK" 
                        Background="#1D9E75" Foreground="White" Height="50" FontSize="14" FontWeight="Black" Cursor="Hand">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="12"/></Style></Button.Resources>
                </Button>
            </Grid>
        </Border>

        <!-- 3. Table Tier: Audit Logs -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <TextBlock Grid.Row="0" Text="RECENT PROCUREMENT AUDIT LOG" FontSize="10" FontWeight="Black" Foreground="#94A3B8" Margin="0,0,0,10"/>
            
            <Border Grid.Row="1" Background="White" CornerRadius="16" BorderBrush="#E2E8F0" BorderThickness="1">
                <DataGrid ItemsSource="{Binding Purchases}" AutoGenerateColumns="False" CanUserAddRows="False" Background="Transparent" 
                          BorderThickness="0" HeadersVisibility="Column" GridLinesVisibility="None" RowBackground="White" AlternatingRowBackground="#F8FAFC">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="#94A3B8"/>
                            <Setter Property="FontWeight" Value="Black"/>
                            <Setter Property="FontSize" Value="10"/>
                            <Setter Property="Padding" Value="20,15"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="#F1F5F9"/>
                        </Style>
                        <Style TargetType="DataGridRow">
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="#F1F5F9"/>
                            <Setter Property="MinHeight" Value="48"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <EventSetter Event="MouseLeftButtonUp" Handler="DataGridRow_MouseLeftButtonUp"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F1F5F9"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>


                        <DataGridTextColumn Header="TIME" Binding="{Binding PurchaseDate, StringFormat=HH:mm}" Width="80">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#94A3B8"/> <Setter Property="Margin" Value="10,0,0,0"/> <Setter Property="VerticalAlignment" Value="Center"/></Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="SUPPLIER" Binding="{Binding SupplierName}" Width="150">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/></Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="PRODUCT NAME" Binding="{Binding ProductName}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock"><Setter Property="FontWeight" Value="Bold"/> <Setter Property="Foreground" Value="#1E293B"/> <Setter Property="VerticalAlignment" Value="Center"/></Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="QTY" Binding="{Binding Quantity, StringFormat=+{0}}" Width="80">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#1D9E75"/> <Setter Property="FontWeight" Value="Black"/> <Setter Property="VerticalAlignment" Value="Center"/></Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="TOTAL COST" Binding="{Binding TotalCost, StringFormat=Rs {0:N0}}" Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock"><Setter Property="FontWeight" Value="Black"/> <Setter Property="TextAlignment" Value="Right"/> <Setter Property="VerticalAlignment" Value="Center"/> <Setter Property="Margin" Value="0,0,20,0"/></Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <!-- 4. MODAL OVERLAY: Premium Transaction Details -->
        <Grid Grid.RowSpan="3" Margin="-30" Visibility="{Binding IsDetailModalOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="Black" Opacity="0.4" MouseDown="Border_MouseDown"/>
            
            <Border Background="#F7F8FA" CornerRadius="24" MaxWidth="440" VerticalAlignment="Center" HorizontalAlignment="Center" ClipToBounds="True">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="0" Color="#000000" Opacity="0.15"/>
                </Border.Effect>
                
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Gradient Header -->
                        <RowDefinition Height="Auto"/> <!-- Product Hero -->
                        <RowDefinition Height="Auto"/> <!-- Unified Info Row -->
                        <RowDefinition Height="Auto"/> <!-- Table breakdown -->
                        <RowDefinition Height="Auto"/> <!-- Footer Button -->
                    </Grid.RowDefinitions>

                    <!-- 1. Gradient Header -->
                    <Border Grid.Row="0" Height="80" Padding="30,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#1D9E75" Offset="0.0"/>
                                <GradientStop Color="#0F6E56" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📋" FontSize="22" Foreground="White" Margin="0,0,15,0"/>
                            <TextBlock Text="TRANSACTION DETAILS" FontSize="11" FontWeight="Black" Foreground="White" Opacity="0.9"/>
                        </StackPanel>
                    </Border>

                    <!-- 2. Product Hero Section -->
                    <StackPanel Grid.Row="1" Margin="30,30,30,20">
                        <TextBlock Text="PRODUCT" FontSize="9" FontWeight="Black" Foreground="#94A3B8" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding SelectedPurchaseHistory.ProductName}" FontSize="36" FontWeight="Black" Foreground="#1E293B" TextWrapping="Wrap" LineHeight="40"/>
                    </StackPanel>

                    <!-- 3. Unified Info Row (Pill Style) -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="30,0,30,25">
                        <!-- Supplier Chip -->
                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="100" Padding="12,6" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="👤" FontSize="10" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding SelectedPurchaseHistory.SupplierName}" FontSize="12" FontWeight="Bold" Foreground="#475569"/>
                            </StackPanel>
                        </Border>
                        <!-- Date Chip -->
                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="100" Padding="12,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🕒" FontSize="10" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding SelectedPurchaseHistory.PurchaseDate, StringFormat='dd MMM, HH:mm'}" FontSize="12" FontWeight="Bold" Foreground="#475569"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 4. Breakdown Table Card -->
                    <Border Grid.Row="3" Margin="30,0,30,35" Background="White" CornerRadius="16" BorderBrush="#E2E8F0" BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDetailModalOpen}" Value="True">
                                        <Setter Property="BorderBrush" Value="#0F6E56"/> <!-- Subtle accent tint -->
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        
                        <Border Padding="20">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <TextBlock Text="Quantity" Foreground="#64748B" FontSize="13"/>
                                    <TextBlock Text="{Binding SelectedPurchaseHistory.Quantity}" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#1E293B" FontSize="13"/>
                                </Grid>
                                <Grid Margin="0,0,0,12">
                                    <TextBlock Text="Unit Cost" Foreground="#64748B" FontSize="13"/>
                                    <TextBlock Text="{Binding SelectedPurchaseHistory.CostPrice, StringFormat=Rs {0:N0}}" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#1E293B" FontSize="13"/>
                                </Grid>
                                
                                <Rectangle Height="1" Fill="#F1F5F9" Margin="-20,8,-20,15"/>
                                
                                <Grid>
                                    <TextBlock Text="TOTAL AMOUNT" VerticalAlignment="Center" FontWeight="Black" Foreground="#64748B" FontSize="10"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Border Background="#ECFDF5" CornerRadius="6" Padding="6,2" Margin="0,0,8,0">
                                            <TextBlock Text="PKR" FontSize="10" FontWeight="Black" Foreground="#0F6E56"/>
                                        </Border>
                                        <TextBlock Text="{Binding SelectedPurchaseHistory.TotalCost, StringFormat={}{0:N0}}" FontSize="24" FontWeight="Black" Foreground="#0F6E56"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Border>

                    <!-- 5. Pill CTA Button -->
                        <Button Grid.Row="4" Margin="30,0,30,35" Command="{Binding CloseDetailCommand}" Height="54" 
                            Background="#0F6E56" Foreground="White" FontSize="15" FontWeight="Black" Cursor="Hand">
                        <Button.Effect>
                            <DropShadowEffect BlurRadius="15" ShadowDepth="4" Color="#0F6E56" Opacity="0.2"/>
                        </Button.Effect>
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="27">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="✔️" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        DONE
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
