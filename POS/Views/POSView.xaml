<UserControl x:Class="POS.Views.POSView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1000">
    <Grid Background="#F8FAFC">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/> <!-- Main Catalog -->
            <ColumnDefinition Width="380"/> <!-- Order Sidebar -->
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Search & Filters -->
                <RowDefinition Height="Auto"/> <!-- Category Pills -->
                <RowDefinition Height="*"/>    <!-- Product Grid -->
            </Grid.RowDefinitions>

            <!-- 1. Search Bar -->
            <Border Grid.Row="0" Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="15,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="🔍" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#94A3B8"/>
                    <TextBox Grid.Column="1" Text="{Binding ProductSearchText, UpdateSourceTrigger=PropertyChanged}" 
                             BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center"
                             FontSize="16" Foreground="#1E293B">
                        <TextBox.Resources>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="CornerRadius" Value="0"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>
                </Grid>
            </Border>

            <!-- 2. Category Pills -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,20">
                <Button Content="ALL ITEMS" Command="{Binding ChangeCategoryCommand}" CommandParameter="All" Margin="0,0,10,0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Padding" Value="20,8"/>
                            <Setter Property="Background" Value="#F1F5F9"/>
                            <Setter Property="Foreground" Value="#64748B"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="20" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedCategory}" Value="All">
                                    <Setter Property="Background" Value="#1D9E75"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="HARDWARE" Command="{Binding ChangeCategoryCommand}" CommandParameter="Hardware" Margin="0,0,10,0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Padding" Value="20,8"/>
                            <Setter Property="Background" Value="#F1F5F9"/>
                            <Setter Property="Foreground" Value="#64748B"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="20" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedCategory}" Value="Hardware">
                                    <Setter Property="Background" Value="#1D9E75"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="SUPPLIES" Command="{Binding ChangeCategoryCommand}" CommandParameter="Supplies" Margin="0,0,10,0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Padding" Value="20,8"/>
                            <Setter Property="Background" Value="#F1F5F9"/>
                            <Setter Property="Foreground" Value="#64748B"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="20" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedCategory}" Value="Supplies">
                                    <Setter Property="Background" Value="#1D9E75"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="STAFF ONLY" Command="{Binding ChangeCategoryCommand}" CommandParameter="Staff">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Padding" Value="20,8"/>
                            <Setter Property="Background" Value="#F1F5F9"/>
                            <Setter Property="Foreground" Value="#64748B"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="20" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedCategory}" Value="Staff">
                                    <Setter Property="Background" Value="#1D9E75"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>

            <!-- 3. Product Grid -->
            <ListBox Grid.Row="2" ItemsSource="{Binding FilteredProducts}" BorderThickness="0" Background="Transparent" 
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" Padding="0,5">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Button Command="{Binding DataContext.AddToCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand">
                            <Border Background="White" CornerRadius="16" BorderBrush="#E2E8F0" BorderThickness="1" 
                                    Width="160" Height="140" Margin="8" Padding="15">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/> <!-- Icon -->
                                        <RowDefinition Height="*"/>    <!-- Name -->
                                        <RowDefinition Height="Auto"/> <!-- Price -->
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <TextBlock Text="📦" FontSize="20" HorizontalAlignment="Left"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock Text="STOCK: " FontSize="10" Foreground="#64748B" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding Quantity}" FontSize="10" Foreground="#64748B" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" Foreground="#1E293B" 
                                               TextWrapping="Wrap" Margin="0,10,0,5" Grid.Row="1" VerticalAlignment="Top"/>
                                    <TextBlock Text="{Binding SellingPrice, StringFormat=Rs {0:N0}}" Foreground="#1D9E75" 
                                               FontWeight="Black" FontSize="16" Grid.Row="2"/>
                                </Grid>
                            </Border>
                        </Button>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>
        </Grid>

        <!-- Right Side: Order Sidebar -->
        <Grid Grid.Column="1" HorizontalAlignment="Stretch" Background="White">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>    <!-- Top Half: Cart Items -->
                <RowDefinition Height="Auto"/> <!-- Divider -->
                <RowDefinition Height="380"/>  <!-- Bottom Half: Ledger & Checkout -->
            </Grid.RowDefinitions>

            <!-- Top: Cart -->
            <Grid Grid.Row="0" Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="ORDER CART" FontSize="18" FontWeight="Black" Foreground="#1E293B" Margin="0,0,0,15"/>
                <ListBox Grid.Row="1" ItemsSource="{Binding CartItems}" BorderThickness="0" Background="Transparent" 
                         HorizontalContentAlignment="Stretch">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#F8FAFC" CornerRadius="12" Margin="0,0,0,8" Padding="15">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="#1E293B"/>
                                        <TextBlock Text="{Binding Price, StringFormat=Rs {0:N0}}" FontSize="12" Foreground="#64748B"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Quantity, StringFormat=x{0}}" FontWeight="Black" Foreground="#1D9E75" Margin="0,0,10,0"/>
                                        <Button Command="{Binding DataContext.RemoveFromCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                CommandParameter="{Binding}" Content="✕" Foreground="#DC2626" Background="Transparent" BorderThickness="0" Cursor="Hand"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <Border Grid.Row="1" Height="1" Background="#E2E8F0" Margin="20,0"/>

            <!-- Bottom: Ledger & Processing -->
            <Grid Grid.Row="2" Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Customer Search -->
                    <RowDefinition Height="*"/>    <!-- Ledger Row List -->
                    <RowDefinition Height="Auto"/> <!-- Total Paid Input -->
                    <RowDefinition Height="Auto"/> <!-- Complete Button -->
                </Grid.RowDefinitions>

                <!-- Customer Search Module -->
                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="LINK CUSTOMER (OPTIONAL)" FontSize="10" FontWeight="Black" Foreground="#94A3B8" Margin="0,0,0,5"/>
                        <ComboBox IsEditable="True" Style="{x:Null}" 
                                  ItemsSource="{Binding FilteredCustomers}"
                                  Text="{Binding CustomerSearchText, UpdateSourceTrigger=PropertyChanged}"
                                  SelectedItem="{Binding SelectedCustomer}"
                                  TextSearch.TextPath="Name"
                                  IsDropDownOpen="{Binding IsCustomerDropdownOpen}"
                                  StaysOpenOnEdit="True"
                                  FontSize="14">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="4">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding Phone}" FontSize="11" Foreground="#94A3B8"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <!-- 5-Row Financial Ledger -->
                <StackPanel Grid.Row="1">
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="PREVIOUS DUES" Foreground="#64748B" FontSize="13"/>
                        <TextBlock Text="{Binding SelectedCustomer.TotalDues, StringFormat=Rs {0:N0}}" HorizontalAlignment="Right" Foreground="#DC2626" FontWeight="Bold"/>
                    </Grid>
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="CURRENT BILL" Foreground="#64748B" FontSize="13"/>
                        <TextBlock Text="{Binding TotalAmount, StringFormat=Rs {0:N0}}" HorizontalAlignment="Right" Foreground="#1E293B" FontWeight="Bold"/>
                    </Grid>
                    <Grid Margin="0,0,0,15">
                        <TextBlock Text="GRAND TOTAL" Foreground="#64748B" FontSize="13" FontWeight="Bold"/>
                        <TextBlock Text="{Binding TotalBillWithOld, StringFormat=Rs {0:N0}}" HorizontalAlignment="Right" Foreground="#1E293B" FontSize="16" FontWeight="Black"/>
                    </Grid>
                    
                    <!-- Input Section -->
                    <Border Background="#F1F5F9" CornerRadius="12" Padding="15,10">
                        <Grid>
                            <TextBlock Text="AMOUNT PAID" VerticalAlignment="Center" Foreground="#64748B" FontWeight="Bold"/>
                            <TextBox Text="{Binding AmountPaid, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Right" Width="100" TextAlignment="Right" 
                                     Background="Transparent" BorderThickness="0" FontSize="18" FontWeight="Black" Foreground="#1D9E75"/>
                        </Grid>
                    </Border>
                    
                    <Grid Margin="0,15,0,0">
                        <TextBlock Text="REMAINING DUES" Foreground="#64748B" FontSize="13" FontWeight="Bold"/>
                        <TextBlock Text="{Binding RemainingKhata, StringFormat=Rs {0:N0}}" HorizontalAlignment="Right" Foreground="#DC2626" FontSize="18" FontWeight="Black"/>
                    </Grid>
                </StackPanel>

                <!-- Action Button -->
                <Button Grid.Row="3" Command="{Binding CompleteSaleCommand}" Content="COMPLETE TRANSACTION" 
                        Background="#1D9E75" Foreground="White" FontSize="16" FontWeight="Black" Height="56" BorderThickness="0" Cursor="Hand">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="12"/></Style></Button.Resources>
                </Button>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
