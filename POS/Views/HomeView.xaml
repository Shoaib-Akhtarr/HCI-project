<UserControl x:Class="POS.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1000" Background="#F5F6FA">
    
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/> <!-- Main Chart Area -->
            <RowDefinition Height="Auto"/> <!-- 4 Summary Cards -->
        </Grid.RowDefinitions>

        <!-- Line Chart Area -->
        <Border Grid.Row="0" Margin="0,0,0,20" Background="White" CornerRadius="12" BorderBrush="#E5E7EB" BorderThickness="1" Padding="25">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <StackPanel Grid.Row="0">
                    <TextBlock Text="LAST 7 DAYS" FontSize="14" FontWeight="SemiBold" Foreground="#6B7280"/>
                    <TextBlock Text="PERFORMANCE OVERVIEW" FontSize="24" FontWeight="Black" Foreground="#111827" Margin="0,4,0,0"/>
                </StackPanel>
                
                <!-- LiveCharts Component -->
                <lvc:CartesianChart Grid.Row="2" Margin="0,20,0,0" Series="{Binding SalesTrendSeries}">
                    <lvc:CartesianChart.AxisX>
                        <lvc:Axis Labels="{Binding TrendLabels}" Foreground="#94A3B8">
                            <lvc:Axis.Separator>
                                <lvc:Separator Step="1" IsEnabled="False"/>
                            </lvc:Axis.Separator>
                        </lvc:Axis>
                    </lvc:CartesianChart.AxisX>
                    <lvc:CartesianChart.AxisY>
                        <lvc:Axis LabelFormatter="{Binding YFormatter}" Foreground="#94A3B8">
                            <lvc:Axis.Separator>
                                <lvc:Separator StrokeDashArray="3" Stroke="#F1F5F9"/>
                            </lvc:Axis.Separator>
                        </lvc:Axis>
                    </lvc:CartesianChart.AxisY>
                </lvc:CartesianChart>
            </Grid>
        </Border>

        <!-- 4 Metric Cards -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Card 1: Total Sale -->
            <Border Grid.Column="0" Margin="0,0,10,0" Background="White" CornerRadius="16" BorderBrush="#E5E7EB" BorderThickness="1" Padding="20">
                <StackPanel>
                    <TextBlock Text="TOTAL SALES REVENUE" FontSize="10" FontWeight="Bold" Foreground="#6B7280" />
                    <TextBlock Text="{Binding TotalSalesRevenue, StringFormat=Rs. {0:N0}}" FontSize="24" FontWeight="Black" Foreground="#111827" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
            
            <!-- Card 2: Profit This Week -->
            <Border Grid.Column="1" Margin="10,0,10,0" Background="White" CornerRadius="16" BorderBrush="#E5E7EB" BorderThickness="1" Padding="20">
                <StackPanel>
                    <TextBlock Text="WEEKLY NET PROFIT" FontSize="10" FontWeight="Bold" Foreground="#6B7280" />
                    <TextBlock Text="{Binding WeeklyProfit, StringFormat=Rs. {0:N0}}" FontSize="24" FontWeight="Black" Foreground="#059669" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- Card 3: Total Purchase -->
            <Border Grid.Column="2" Margin="10,0,10,0" Background="White" CornerRadius="16" BorderBrush="#E5E7EB" BorderThickness="1" Padding="20">
                <StackPanel>
                    <TextBlock Text="WEEKLY INVENTORY COST" FontSize="10" FontWeight="Bold" Foreground="#6B7280" />
                    <TextBlock Text="{Binding WeeklyPurchasesSum, StringFormat=Rs. {0:N0}}" FontSize="24" FontWeight="Black" Foreground="#111827" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- Card 4: Low Stock -->
            <Button Grid.Column="3" Command="{Binding ToggleLowStockModalCommand}" Background="Transparent" BorderThickness="0" Padding="0" Margin="10,0,0,0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="White" CornerRadius="16" BorderBrush="#E5E7EB" BorderThickness="1" Padding="20">
                            <StackPanel>
                                <TextBlock Text="LOW STOCK ALERTS" FontSize="10" FontWeight="Bold" Foreground="#6B7280" />
                                <TextBlock Text="{Binding LowInStockCount}" FontSize="24" FontWeight="Black" Foreground="#DC2626" Margin="0,8,0,0"/>
                                <TextBlock Text="VIEW ITEMS" FontSize="10" FontWeight="Bold" Foreground="#10A574" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

        <!-- Low Stock Modal Overlay -->
        <Grid Grid.RowSpan="2" Margin="-30" Visibility="{Binding IsLowStockModalOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="Black" Opacity="0.4" MouseDown="Border_MouseDown"/>
            
            <Border Background="White" CornerRadius="16" MaxWidth="600" MaxHeight="650" Margin="50" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid Margin="30">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Header -->
                        <RowDefinition Height="Auto"/> <!-- Stats -->
                        <RowDefinition Height="*"/>    <!-- Content Area (Table or Dismissal) -->
                        <RowDefinition Height="Auto"/> <!-- Footer -->
                    </Grid.RowDefinitions>
                    
                    <!-- 1. Header with Icon & Badge -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,25">
                        <TextBlock Text="⚠" Foreground="#D85A30" FontSize="24" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBlock Text="Low Stock Alerts" FontSize="22" FontWeight="Black" Foreground="#111827" VerticalAlignment="Center"/>
                        <Border Background="#FEE2E2" CornerRadius="12" Padding="10,4" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding LowInStockCount, StringFormat={}{0} alerts}" Foreground="#D85A30" FontSize="11" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>

                    <!-- 2. Summary Stat Cards -->
                    <Grid Grid.Row="1" Margin="0,0,0,25" Visibility="{Binding IsAlertDismissed, Converter={StaticResource InverseBoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="15,12" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="TOTAL ALERTS" FontSize="9" FontWeight="Black" Foreground="#64748B"/>
                                <TextBlock Text="{Binding LowInStockCount}" FontSize="18" FontWeight="Black" Foreground="#111827" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        
                        <Border Grid.Column="1" Background="#FFF1F2" BorderBrush="#FECDD3" BorderThickness="1" CornerRadius="12" Padding="15,12" Margin="4,0,4,0">
                            <StackPanel>
                                <TextBlock Text="CRITICAL (0 UNITS)" FontSize="9" FontWeight="Black" Foreground="#BE123C"/>
                                <TextBlock Text="{Binding CriticalAlertCount}" FontSize="18" FontWeight="Black" Foreground="#D85A30" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="15,12" Margin="8,0,0,0">
                            <StackPanel>
                                <TextBlock Text="LOWEST STOCK" FontSize="9" FontWeight="Black" Foreground="#64748B"/>
                                <TextBlock Text="{Binding LowestUnitInfo}" FontSize="13" FontWeight="Bold" Foreground="#111827" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    
                    <!-- 3. Content Area: Table -->
                    <DataGrid Grid.Row="2" ItemsSource="{Binding LowStockProducts}" AutoGenerateColumns="False" 
                              CanUserAddRows="False" Margin="0,0,0,20" BorderThickness="0" Background="Transparent" 
                              RowBackground="White" HeadersVisibility="Column" GridLinesVisibility="None"
                              Visibility="{Binding IsAlertDismissed, Converter={StaticResource InverseBoolToVis}}">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="#94A3B8"/>
                                <Setter Property="FontSize" Value="10"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Padding" Value="0,0,0,10"/>
                                <Setter Property="BorderThickness" Value="0"/>
                            </Style>
                            <Style TargetType="DataGridRow">
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="#F1F5F9"/>
                                <Setter Property="MinHeight" Value="45"/>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <!-- Product Name with Status Dot -->
                            <DataGridTemplateColumn Header="PRODUCT NAME" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="8" Height="8" Margin="0,0,10,0">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="#F59E0B"/> <!-- Amber -->
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Quantity, Converter={StaticResource StockPillVis}}" Value="Visible">
                                                                <Setter Property="Fill" Value="#D85A30"/> <!-- Coral/Red -->
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#1E293B"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Category with Pills -->
                            <DataGridTemplateColumn Header="CATEGORY" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="10" Padding="8,3" HorizontalAlignment="Left">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#F1F5F9"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Category}" Value="Supplies">
                                                            <Setter Property="Background" Value="#DCFCE7"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Category}" Value="Abc">
                                                            <Setter Property="Background" Value="#DBEAFE"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Category}" FontSize="10" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#64748B"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Category}" Value="Supplies">
                                                                <Setter Property="Foreground" Value="#1D9E75"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Category}" Value="Abc">
                                                                <Setter Property="Foreground" Value="#3B82F6"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Units with Circle Badges -->
                            <DataGridTemplateColumn Header="STOCK" Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Width="28" Height="28" CornerRadius="14" BorderThickness="2" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderBrush" Value="#FDE68A"/> <!-- Amber border -->
                                                    <Setter Property="Background" Value="#FFFBEB"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Quantity, Converter={StaticResource StockPillVis}}" Value="Visible">
                                                            <Setter Property="BorderBrush" Value="#FECDD3"/> <!-- Coral border -->
                                                            <Setter Property="Background" Value="#FFF1F2"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Quantity}" FontSize="10" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#D97706"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Quantity, Converter={StaticResource StockPillVis}}" Value="Visible">
                                                                <Setter Property="Foreground" Value="#D85A30"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- 4. Dismissal Confirmation Message -->
                    <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding IsAlertDismissed, Converter={StaticResource BoolToVis}}">
                        <Border Width="60" Height="60" CornerRadius="30" Background="#DCFCE7" Margin="0,0,0,20">
                            <TextBlock Text="✓" Foreground="#1D9E75" FontSize="30" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Alerts Dismissed" FontSize="18" FontWeight="Bold" Foreground="#111827" HorizontalAlignment="Center"/>
                        <TextBlock Text="The low stock warning has been acknowledged." FontSize="13" Foreground="#64748B" Margin="0,8,0,20" HorizontalAlignment="Center"/>
                        <Button Command="{Binding RestoreAlertCommand}" Content="REOPEN ALERTS" Background="Transparent" Foreground="#1D9E75" FontWeight="Bold" Cursor="Hand" BorderThickness="0"/>
                    </StackPanel>

                    <!-- 5. Footer Footer -->
                    <Grid Grid.Row="3">
                        <Button Command="{Binding DismissAlertCommand}" Content="ACKNOWLEDGE &amp; CLOSE" Background="#1D9E75" Foreground="White" FontWeight="Bold" Padding="0,15" BorderThickness="0" Cursor="Hand" Visibility="{Binding IsAlertDismissed, Converter={StaticResource InverseBoolToVis}}">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="12"/></Style></Button.Resources>
                        </Button>
                        <Button Command="{Binding ToggleLowStockModalCommand}" Content="DONE" Background="#1D9E75" Foreground="White" FontWeight="Bold" Padding="0,15" BorderThickness="0" Cursor="Hand" Visibility="{Binding IsAlertDismissed, Converter={StaticResource BoolToVis}}">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="12"/></Style></Button.Resources>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
